+#include <unistd.h>
 
 std::string GetExeName()
 {
@@ -45,6 +47,44 @@ std::string GetExeName()
 	}
 	return { "" };
 }
+
+// The macOS OpenXR loader only reads XR_RUNTIME_JSON or /usr/local/share/openxr/1/active_runtime[.<arch>].json;
+// runtimes (WiVRn) set the per-user XDG one, as on Linux. Point the loader at it unless one of those is set.
+// Set before anything else loads OpenXR, and inherited by the web overlay broker and helper.
+static bool ActiveRuntimeIn(const std::string& dir, std::string& out)
+{
+#if defined(__aarch64__)
+	const char* arch = "aarch64";
+#else
+	const char* arch = "x86_64";
+#endif
+	for (std::string name : { std::string("active_runtime.") + arch + ".json", std::string("active_runtime.json") }) {
+		char real[PATH_MAX];
+		if (realpath((dir + "/openxr/1/" + name).c_str(), real)) {
+			out = real;
+			return true;
+		}
+	}
+	return false;
+}
+
+static void UseUserActiveRuntime()
+{
+	std::string found;
+	if (getenv("XR_RUNTIME_JSON") || ActiveRuntimeIn("/usr/local/share", found))
+		return;
+	std::string dir;
+	if (const char* xdg = getenv("XDG_CONFIG_HOME"); xdg && *xdg == '/')
+		dir = xdg;
+	else if (const char* home = getenv("HOME"); home && *home)
+		dir = std::string(home) + "/.config";
+	else
+		return;
+	if (!ActiveRuntimeIn(dir, found))
+		return;
+	setenv("XR_RUNTIME_JSON", found.c_str(), 0);
+	OOVR_LOGF("Using the user's active OpenXR runtime %s", found.c_str());
+}
 #else
 #include <libgen.h> // basename
 #include <linux/limits.h> // PATH_MAX
@@ -150,6 +190,10 @@ IBackend* DrvOpenXR::CreateOpenXRBackend(const char* startupInfo, vr::EVRInitErr
 	OOVR_LOGF("Set OpenXR validation file path: %s", XR_VALIDATION_FILE_NAME);
 #endif
 
+#ifdef __APPLE__
+	UseUserActiveRuntime();
+#endif
+
